{
  "name": "api3-dao-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24",
    "pnpm": "^11.19.0"
  },
  "scripts": {
    "build": "vite build",
    "ci:cypress": "pnpm start-test \"pnpm concurrently 'pnpm eth:node' 'pnpm ci:start'\" '8545|3000' 'pnpm eth:deploy-dao-contracts-on-hardhat && pnpm cypress:run'",
    "ci:start": "FORCE_COLOR=true pnpm start | cat",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "eth:deploy-dao-contracts-on-hardhat": "node dev-scripts/deploy-dao-contracts-on-hardhat.js",
    "eth:node": "cd hardhat && npx hardhat node --network hardhat",
    "eth:prepare-dao-contracts-for-hardhat": "node dev-scripts/prepare-dao-contracts-for-hardhat.js",
    "eth:run-script": "cd hardhat && npx hardhat run",
    "fix-dev-issues": "node dev-scripts/copy-localhost-data.js && node dev-scripts/generate-typechain-artifacts.js",
    "lint:fix": "eslint --fix --ext js,mjs,ts,tsx src dev-scripts vite.config.mts",
    "lint": "pnpm prettier:check && eslint --ext js,mjs,ts,tsx src dev-scripts vite.config.mts",
    "prettier:check": "prettier --check ./**/*.{js,mjs,ts,mts,tsx,json,css,scss,md,html}",
    "prettier": "prettier --write ./**/*.{js,mjs,ts,mts,tsx,json,css,scss,md,html}",
    "postinstall": "pnpm fix-dev-issues",
    "postuninstall": "pnpm fix-dev-issues",
    "prepare": "husky install",
    "send-to-account": "cd hardhat && npx hardhat send-to-account --address",
    "create-proposal": "cd hardhat && npx hardhat create-proposal",
    "upload-build-to-pinata": "node dev-scripts/upload-build-to-pinata.mjs",
    "start": "vite",
    "preview": "vite preview",
    "test:watch": "vitest",
    "test": "vitest run",
    "tsc:watch": "tsc --project tsconfig.json --watch",
    "tsc": "tsc --project tsconfig.json"
  },
  "browserslist": {
    "production": [
      ">0.2% and supports bigint",
      "not ie <= 99",
      "not android <= 4.4.4",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@api3/commons": "^1.3.0",
    "@ethersproject/abi": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@sentry/react": "^6.19.7",
    "@web3modal/wagmi": "^3.5.7",
    "classnames": "^2.5.1",
    "date-fns": "^2.30.0",
    "ethers": "^5.8.0",
    "immer": "^9.0.21",
    "lodash": "^4.17.23",
    "rc-tooltip": "^6.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-focus-lock": "^2.13.7",
    "react-helmet-async": "^1.3.0",
    "react-input-autosize": "^3.0.0",
    "react-number-format": "^4.9.4",
    "react-router-dom": "^5.3.4",
    "react-toastify": "^7.0.4",
    "viem": "^1.21.4",
    "wagmi": "^1.4.13"
  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@percy/cli": "1.18.0",
    "@percy/cypress": "^3.1.2",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@typechain/ethers-v5": "^11.1.2",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.6",
    "@types/node": "^16.11.7",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.2.18",
    "@types/react-input-autosize": "^2.2.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "api3-dao": "git+https://github.com/api3dao/api3-dao.git#0b8bb17fbda0161d5d9fff00ed4562b91cc27af6",
    "autoprefixer": "^10.5.4",
    "browserslist-to-esbuild": "^2.1.1",
    "chalk": "^4.1.2",
    "concurrently": "^7.6.0",
    "cypress": "^15.11.0",
    "cypress-plugin-tab": "^1.0.5",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "hardhat": "^2.19.4",
    "husky": "^8.0.3",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "sass": "^1.69.7",
    "start-server-and-test": "^2.0.8",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "5.9.3",
    "typescript-plugin-css-modules": "^5.0.2",
    "vite": "^8.2.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.10"
  }
}
